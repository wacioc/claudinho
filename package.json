{
  "name": "claudinho",
  "version": "0.7.3",
  "description": "Desktop monitor for the Claude Code instances running in a repo",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "check:cpu": "node cpu-check.js",
    "check:box": "node box-check.js",
    "predist": "node -e \"for (const a of ['arm64', 'x64']) try { fs.chmodSync('node_modules/node-pty/prebuilds/darwin-' + a + '/spawn-helper', 0o755) } catch {}\"",
    "dist": "electron-builder --publish never",
    "check:pack": "node pack-check.js"
  },
  "build": {
    "appId": "io.github.wacioc.claudinho",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "lib.js",
      "cpu.js",
      "containers.js",
      "container/**",
      "renderer/**",
      "!**/*.pdb"
    ],
    "asar": false,
    "npmRebuild": false,
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "owner": "wacioc",
      "repo": "claudinho"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "koffi": "^3.3.7",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
